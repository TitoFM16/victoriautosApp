# syntax=docker/dockerfile:1
# Local-development image. Source lives on a bind mount (see ../docker-compose.yml)
# so this only provides the Python/uv toolchain - `uv sync` runs on container
# start against whatever pyproject.toml/uv.lock is mounted in.
FROM python:3.13-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

EXPOSE 3005

CMD ["sh", "-c", "uv sync --locked && uv run alembic upgrade head && uv run victoriautos-backend"]
