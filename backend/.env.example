# Copy to .env; use chmod 600. Never commit real secrets.
# Set production on EC2: hides API docs and enables secure production cookies.
ENVIRONMENT=development

# Async PostgreSQL URL. Production: owner role/database victoriautos on 127.0.0.1:5432.
# URL-encode special characters in the password. Local compose uses port 5433.
DATABASE_URL=postgresql+asyncpg://victoriautos:CHANGE_ME@127.0.0.1:5432/victoriautos
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
# Session duration in seconds (one hour).
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# reCAPTCHA v2 secret; register victoriautos.com and www.victoriautos.com.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# JSON array, exact origins, no wildcard with credentials. Add localhost only in dev.
CORS_ORIGINS=["https://victoriautos.com","https://www.victoriautos.com","https://d2gyx3l0a1l011.cloudfront.net"]

# Unset locally to use backend/data/images. Production service/backup/nginx runbook
# uses this absolute path; keep the service ReadWritePaths in sync if changed.
# IMAGES_DIR=/home/ubuntu/victoriautosApp/backend/data/images
# Per-file bytes (20 MiB), maximum six images per request; nginx body cap is 125m
# (120 MiB image data + 5 MiB multipart/form headroom). Update nginx if these change.
MAX_UPLOAD_SIZE_BYTES=20971520
MAX_UPLOAD_FILES=6
WEBP_QUALITY=80

# Existing local SIMIT service in production; no change to its pm2 process required.
# Use the hosted URL instead in development if the local service is unavailable.
SIMIT_API_URL=http://127.0.0.1:8000/search
FASECOLDA_API_URL=https://fasecolda-api.onrender.com/search
PLATE_LOOKUP_MAX_RETRIES=5

# Defaults to backend/templates/Contrato-Compraventa-de-Vehiculo-Automotor-Minerva.pdf.
# CONTRACT_TEMPLATE_PATH=/home/ubuntu/victoriautosApp/backend/templates/Contrato-Compraventa-de-Vehiculo-Automotor-Minerva.pdf
# Test-only; never point this at production (tests create/drop/truncate tables).
# TEST_DATABASE_URL=postgresql+asyncpg://victoriautos:password@localhost:5433/victoriautos_test
