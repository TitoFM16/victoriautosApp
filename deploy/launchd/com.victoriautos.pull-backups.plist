<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pulls the EC2 nightly backups to this Mac every day at 22:00 local time
  (server backups run at 02:30 UTC = 21:30 Colombia). If the Mac is asleep at
  22:00, launchd runs the job on wake. Install with deploy/scripts/install_backup_pull.sh.
  __HOME__ is replaced with your home directory at install time.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.victoriautos.pull-backups</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/workspace/VAC/victoriautosApp/deploy/scripts/pull_backups.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>22</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/victoriautos-backups/nightly/pull.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/victoriautos-backups/nightly/pull.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
