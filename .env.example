# Copy to .env and fill in real values for your environment.

ENVIRONMENT=development

# PostgreSQL (async, asyncpg driver)
# If using the bundled docker-compose Postgres, use:
# postgresql+asyncpg://victoriautos:victoriautos@localhost:5433/victoriautos
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/victoriautos

# JWT signing secret - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

# reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=

# Local image storage root (defaults to <repo>/data/images if unset)
# IMAGES_DIR=/path/to/data/images
