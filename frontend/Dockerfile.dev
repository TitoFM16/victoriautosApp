# syntax=docker/dockerfile:1
# Local-development image. Source lives on a bind mount (see ../docker-compose.yml)
# so this only provides the Node toolchain - `yarn install` runs on container
# start against whatever package.json/yarn.lock is mounted in.
FROM node:22-alpine

WORKDIR /app

EXPOSE 5173

CMD ["sh", "-c", "yarn install --frozen-lockfile && yarn dev --host 0.0.0.0"]
